{
  "layer": "top",
  "position": "top",
  "height": 24,
  "spacing": 0,
  "modules-left": [
    "hyprland/workspaces",
    "tray",
    "custom/lock",
    // "custom/sleep" removed: suspend hard-locks this machine (RX 7900 XT / Navi 31
    // amdgpu SMU suspend bug — GPU fails to suspend/resume and the reset wedges the
    // card: fans to 100%, no wake, requires a forced power-off). See custom/sleep
    // definition below. Re-enable only once the amdgpu driver bug is fixed.
    "custom/reboot",
    "custom/power"
  ],
  "modules-center": [
    "image#spotify-art",
    "custom/spotify",
    "custom/spotify-prev",
    "custom/spotify-playpause",
    "custom/spotify-next",
    "custom/cava"
  ],
  "modules-right": [
    "network",
    // "battery",
    "bluetooth",
    "custom/capslock",
    "custom/mic",
    "custom/audio",
    // "backlight",
    "custom/temperature",
    "memory",
    "cpu",
    "custom/claude",
    "clock"
  ],
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": false,
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
      "HDMI-A-1": ["1", "2"],  // left
      "DP-2": ["6", "7"],      // center
      "DP-3": ["11", "12"]     // right
    },
    "format-icons": {
      "1": "L1",
      "2": "L2",
      "3": "L3",
      "4": "L4",
      "5": "L5",
      "6": "C1",
      "7": "C2",
      "8": "C3",
      "9": "C4",
      "10": "C5",
      "11": "R1",
      "12": "R2",
      "13": "R3",
      "14": "R4",
      "15": "R5"
    }
  },
  "custom/lock": {
    "format": "<span color='#00FFFF'>  </span>",
    "on-click": "~/.config/hypr/scripts/lock-and-pause.sh",
    "tooltip": true,
    "tooltip-format": "Lock"
  },
  // Suspend disabled: this machine (RX 7900 XT / Navi 31) hits an amdgpu SMU
  // suspend/resume bug — "suspend of IP block <smu> failed -22", GPU reset fails,
  // card wedges with fans at 100% and the power button dead, needing a forced
  // power-off. Intermittent (s2idle reduced but did not eliminate it). Not fixable
  // from config/scripts — it's a kernel/driver bug. Removed from modules-left above.
  // Re-enable this block + the module entry once the amdgpu driver bug is resolved.
  // "custom/sleep": {
  //   "format": "<span color='#BF00FF'> 󰤄 </span>",
  //   "on-click": "~/.config/hypr/scripts/sleep.sh",
  //   "tooltip": true,
  //   "tooltip-format": "Sleep"
  // },
  "custom/reboot": {
    "format": "<span color='#FFD700'> 󰑙 </span>",
    "on-click": "systemctl reboot",
    "tooltip": true,
    "tooltip-format": "Reboot"
  },
  "custom/power": {
    "format": "<span color='#FF4040'>  </span>",
    "on-click": "systemctl poweroff",
    "tooltip": true,
    "tooltip-format": "Shut Down"
  },
  "network": {
    "format-wifi": "<span color='#00FFFF'> 󰤨 </span>{signalStrength}% ",
    "format-ethernet": "<span color='#7FFF00'> </span>Wired ",
    "tooltip-format": "<span color='#FF1493'> 󰅧 </span>{bandwidthUpBytes}  <span color='#00BFFF'> 󰅢 </span>{bandwidthDownBytes}",
    "format-linked": "<span color='#FFA500'> 󱘖 </span>{ifname} (No IP) ",
    "format-disconnected": "<span color='#FF4040'>  </span>Disconnected ",
    "format-alt": "<span color='#00FFFF'> 󰤨 </span>{essid} ",
    "interval": 1
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span color='#28CD41'> {icon} </span>{capacity}% ",
    "format-charging": " 󱐋{capacity}%",
    "interval": 1,
    "format-icons": ["󰂎", "󰁼", "󰁿", "󰂁", "󰁹"],
    "tooltip": true
  },
  // Replaces the built-in "pulseaudio" module: the tooltip lists every output
  // device (hover to see, default marked ►) and right-click switches to the
  // next one, moving live streams along. No "interval"/"return-type" polling —
  // the script streams a JSON line per pactl event, so updates are instant.
  "custom/audio": {
    "exec": "~/.config/hypr/scripts/audio-devices.sh watch",
    "return-type": "json",
    "format": "{}",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "~/.config/hypr/scripts/audio-devices.sh cycle sink",
    "on-click-middle": "pavucontrol -t 3",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
    "tooltip": true
  },
  "custom/mic": {
    "exec": "~/.config/hypr/scripts/mic-mute.sh status",
    "return-type": "json",
    "format": "{}",
    "interval": 3,
    "signal": 10,
    "on-click": "~/.config/hypr/scripts/mic-mute.sh toggle",
    "on-click-right": "~/.config/hypr/scripts/audio-devices.sh cycle source",
    "on-click-middle": "pavucontrol -t 4",
    "tooltip": true
  },
  "custom/capslock": {
    "exec": "~/.config/hypr/scripts/caps-lock.sh status",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 11,
    "tooltip": true
  },
  "custom/temperature": {
    "exec": "sensors | awk '/^Package id 0:/ {print int($4)}'",
    "format": "<span color='#FFA500'> </span>{}°C ",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "CPU: {}°C"
  },
  "image#spotify-art": {
    "path": "/home/brayden/.cache/waybar-spotify-art.jpg",
    "size": 18,
    "interval": 2,
    "on-click": "~/.config/hypr/scripts/spotify-focus.sh",
    "on-click-middle": "playerctl --player=spotify play-pause",
    "on-click-right": "playerctl --player=spotify next",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous",
    "tooltip": true
  },
  "custom/spotify": {
    "exec": "~/.config/hypr/scripts/spotify-status.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "on-click": "~/.config/hypr/scripts/spotify-focus.sh",
    "on-click-middle": "playerctl --player=spotify play-pause",
    "on-click-right": "playerctl --player=spotify next",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous",
    "tooltip": true,
    "max-length": 60
  },
  "custom/spotify-prev": {
    "exec": "~/.config/hypr/scripts/spotify-control.sh prev",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "on-click": "playerctl --player=spotify previous",
    "tooltip": true,
    "tooltip-format": "Previous"
  },
  "custom/spotify-playpause": {
    "exec": "~/.config/hypr/scripts/spotify-playpause.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "signal": 9,
    "on-click": "~/.config/hypr/scripts/spotify-playpause.sh toggle",
    "tooltip": true
  },
  "custom/spotify-next": {
    "exec": "~/.config/hypr/scripts/spotify-control.sh next",
    "return-type": "json",
    "format": "{}",
    "interval": 2,
    "on-click": "playerctl --player=spotify next",
    "tooltip": true,
    "tooltip-format": "Next"
  },
  "custom/cava": {
    // No "interval" and no "return-type": waybar keeps this script alive
    // as a stream and updates the module on every newline (each cava frame).
    "exec": "~/.config/hypr/scripts/cava-waybar.sh",
    "format": "{}",
    "tooltip": false
  },
  "custom/claude": {
    "exec": "~/.config/hypr/scripts/claude-usage.sh",
    "on-click": "~/.config/hypr/scripts/claude-usage.sh cycle",
    "return-type": "json",
    "format": "{}",
    // 5 minutes, not seconds: api/oauth/usage rate limits after a handful of
    // requests (429, retry-after ~5min), and this module runs once per output
    // — 3 monitors means 3 near-simultaneous calls per tick. The script also
    // caches the response on disk and serves the last good one on failure.
    "interval": 300,
    "signal": 8,
    "tooltip": true
  },
  "memory": {
    "format": "<span color='#8A2BE2'>  </span>{used:0.1f}G/{total:0.1f}G ",
    "tooltip": true,
    "tooltip-format": "Memory: {used:0.2f}G/{total:0.2f}G"
  },
  "cpu": {
    "format": "<span color='#FF9F0A'>  </span>{usage}% ",
    "tooltip": true
  },
  "clock": {
    "interval": 1,
    "timezone": "America/Mountain/Denver",
    "format": "<span color='#BF00FF'>  </span>{:%I:%M %p} ",
    "tooltip": true,
    "tooltip-format": "{:%A, %Y/%m/%d}"
  },
  "tray": {
    "icon-size": 13,
    "spacing": 6
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "<span color='#FFD700'>{icon}</span>{percent}% ",
    "tooltip": true,
    "tooltip-format": "Backlight: {percent}%",
    "format-icons": [
      "<span color='#696969'> 󰃞 </span>",
      "<span color='#A9A9A9'> 󰃝 </span>",
      "<span color='#FFFF66'> 󰃟 </span>",
      "<span color='#FFD700'> 󰃠 </span>"
    ]
  },
  "bluetooth": {
    "format-off": "<span color='#808080'> 󰂲 </span>",
    "format-disabled": "<span color='#808080'> 󰂲 </span>",
    "on-click": "blueman-manager",
    "on-click-right": "rfkill toggle bluetooth",
    "format": "<span color='#00BFFF'>  </span>",
    "format-connected": "<span color='#00BFFF'>  </span>",
    "format-connected-battery": "<span color='#00BFFF'>  </span>",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  }
}

